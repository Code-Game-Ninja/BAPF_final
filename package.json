{
  "name": "bapf-temp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev",
    "dev:local": "node scripts/dev-local.js",
    "dev:all": "concurrently --kill-others --prefix-colors \"blue,green\" --names \"admin,customer\" \"cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev\" \"cd ../bapf-customer-portal && npm run dev\"",
    "setup": "node scripts/setup.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true next build",
    "db:push": "node scripts/db-push.mjs",
    "db:clear": "node scripts/db-clear.mjs",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:migrate:phase1": "node scripts/run-migrations.mjs --phase 1",
    "db:migrate:phase2": "node scripts/run-migrations.mjs --phase 2",
    "db:migrate:phase3": "node scripts/run-migrations.mjs --phase 3",
    "db:migrate:phase4": "node scripts/run-migrations.mjs --phase 4"
  },
  "dependencies": {
