# Supabase Configuration (Template — copy to .env.local and fill in)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App Configuration
NEXT_PUBLIC_APP_NAME=BP & AF Insurance Broker
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=30

# SMTP Email Configuration (Nodemailer / SendGrid / AWS SES)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BP & AF Insurance <noreply@bpaf.in>"

# Security — Office IP Whitelist (comma-separated, leave empty to disable)
OFFICE_IP_WHITELIST=

# App URL (production domain for CORS)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Sentry Error Tracking (optional)
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_AUTH_TOKEN=your_sentry_auth_token
# SENTRY_ORG=your-org
# SENTRY_PROJECT=bpaf-portal

# E2E Testing (optional, used by Playwright)
# E2E_BASE_URL=http://localhost:3000
# E2E_EMAIL=admin@bpaf.com
# E2E_PASSWORD=Test@1234

# Demo Credentials (dev only - used by DemoCredentialsPicker)
# NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=
# NEXT_PUBLIC_DEMO_MANAGER_PASSWORD=
# NEXT_PUBLIC_DEMO_EMPLOYEE_PASSWORD=

# Seed Script Passwords
# SEED_ADMIN_PASSWORD=
# SEED_MANAGER_PASSWORD=
# SEED_EMPLOYEE_PASSWORD=
